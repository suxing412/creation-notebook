{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "LY-006-interface-v1",
 "title": "Seat interface declaration (filled by each LY-011..LY-090 seat; validated by source/validate_interface.py against registry/)",
 "type": "object",
 "required": ["schema", "seat", "registryVersion", "baseline", "frames", "claims", "zonesUsed", "portsProduced", "portsConsumed", "install", "evidence", "notClaimed", "files"],
 "properties": {
  "schema": {"const": "LY-006-interface-v1"},
  "seat": {"type": "string", "pattern": "^LY-0(1[1-9]|[2-8][0-9]|90)$"},
  "registryVersion": {"type": "integer", "minimum": 1},
  "baseline": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
  "frames": {"type": "array", "items": {"type": "string"}},
  "claims": {
   "type": "object",
   "required": ["sourceObjects", "cityNodes", "groundPieces", "cuts", "cardFields", "components"],
   "properties": {
    "sourceObjects": {"type": "array", "items": {"type": "object", "required": ["objectId", "mode"], "properties": {"objectId": {"type": "string"}, "mode": {"enum": ["modify", "replace", "keep", "hide"]}}}},
    "cityNodes": {"type": "array", "items": {"type": "object", "required": ["nodeId", "action"], "properties": {"nodeId": {"type": "string"}, "action": {"enum": ["keep", "replace-proposal", "hide-proposal", "exclude-nodes-proposal", "add-sibling-proposal"]}}}},
    "groundPieces": {"type": "array", "items": {"type": "string"}},
    "cuts": {"type": "array", "items": {"type": "string"}},
    "cardFields": {"type": "array", "items": {"type": "object", "required": ["field", "proposal"], "properties": {"field": {"type": "string", "description": "<cardId>#<field> or <cardId>#notes.<key>"}, "proposal": {"type": "string"}}}},
    "components": {"type": "array", "items": {"type": "object", "required": ["id", "class"], "properties": {"id": {"type": "string"}, "class": {"type": "string"}, "hostPortId": {"type": "string"}, "states": {"type": "array", "items": {"type": "string"}}, "dof": {"type": "string"}}}}
   }
  },
  "zonesUsed": {"type": "array", "items": {"type": "object", "required": ["zoneId", "boxesWritten"], "properties": {"zoneId": {"type": "string"}, "boxesWritten": {"type": "array", "items": {"type": "array"}}}}},
  "portsProduced": {"type": "array", "items": {"$ref": "port.schema.json"}},
  "portsConsumed": {"type": "array", "items": {"type": "object", "required": ["portId", "version", "ack"], "properties": {"portId": {"type": "string"}, "version": {"type": "integer"}, "ack": {"enum": ["accepted", "rejected-needs-coordinator"]}, "measuredResidual_m": {"type": ["number", "null"]}, "note": {"type": "string"}}}},
  "newGroundPieces": {"type": "array", "items": {"type": "object", "required": ["id", "zoneId"], "properties": {"id": {"type": "string", "pattern": "^gp:LY-0[0-9]{2}:[A-Za-z0-9_.-]+$"}, "zoneId": {"type": "string"}, "file": {"type": "string"}, "sha256": {"type": "string"}}}},
  "install": {"type": "object", "required": ["order", "replaces", "hides", "rollback"]},
  "evidence": {"type": "object", "required": ["原始考古/原文", "异地异期类比", "C工程设计", "未知"]},
  "notClaimed": {"type": "array", "items": {"type": "string"}},
  "files": {"type": "array", "items": {"type": "object", "required": ["path", "sha256", "bytes"]}}
 }
}
