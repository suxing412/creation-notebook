{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vesper constrained geometric family 1.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "seed",
    "recipe_version",
    "shade_width",
    "shade_depth",
    "shade_rise",
    "rim_height",
    "stem_lean",
    "base_width",
    "base_depth",
    "crown_shift"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,30}$"
    },
    "seed": {
      "const": 0,
      "type": "integer"
    },
    "recipe_version": {
      "const": "1.1.0"
    },
    "shade_width": {
      "type": "number",
      "minimum": 0.33,
      "maximum": 0.49
    },
    "shade_depth": {
      "type": "number",
      "minimum": 0.27,
      "maximum": 0.35
    },
    "shade_rise": {
      "type": "number",
      "minimum": 0.05,
      "maximum": 0.12
    },
    "rim_height": {
      "type": "number",
      "minimum": 0.28,
      "maximum": 0.53
    },
    "stem_lean": {
      "type": "number",
      "minimum": 0.025,
      "maximum": 0.065
    },
    "base_width": {
      "type": "number",
      "minimum": 0.16,
      "maximum": 0.21
    },
    "base_depth": {
      "type": "number",
      "minimum": 0.13,
      "maximum": 0.16
    },
    "crown_shift": {
      "type": "number",
      "minimum": 0.008,
      "maximum": 0.022
    }
  },
  "$comment": "Coupled aspect, slope, and visual slenderness constraints are enforced by validate(); new accepted combinations still require full static QA and manual multi-view review."
}