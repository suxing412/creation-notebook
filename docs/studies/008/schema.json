{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VEIL 008 input box; Python runtime adds cross-constraints",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "aperture_ratio",
    "columns",
    "curve_angle_degrees",
    "edge_radius",
    "gradient",
    "height",
    "name",
    "recipe_version",
    "rows",
    "seed",
    "thickness",
    "width"
  ],
  "properties": {
    "width": {
      "type": "number",
      "minimum": 0.24,
      "maximum": 0.58
    },
    "height": {
      "type": "number",
      "minimum": 0.28,
      "maximum": 0.6
    },
    "curve_angle_degrees": {
      "type": "number",
      "minimum": 12,
      "maximum": 90
    },
    "thickness": {
      "type": "number",
      "minimum": 0.006,
      "maximum": 0.014
    },
    "columns": {
      "type": "integer",
      "minimum": 3,
      "maximum": 10
    },
    "rows": {
      "type": "integer",
      "minimum": 4,
      "maximum": 10
    },
    "aperture_ratio": {
      "type": "number",
      "minimum": 0.46,
      "maximum": 0.74
    },
    "gradient": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.22
    },
    "edge_radius": {
      "type": "number",
      "minimum": 0.0006,
      "maximum": 0.0018
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,30}$"
    },
    "seed": {
      "type": "integer",
      "const": 0
    },
    "recipe_version": {
      "const": "1.0.0"
    }
  },
  "$comment": "Not a mesh-validity, visual, manufacturing or continuous-parameter-domain guarantee."
}