 "installOrder": [
  "无安装动作；本席位不改城市。",
  "重算顺序：node source/dump_city_data.mjs <lab>/docs/cities/luoyang/city-data.mjs > qa/city-data.dump.json",
  "git -C <lab> show HEAD:lab/data/assets.json > qa/assets.HEAD.json",
  "python -I source/inventory.py <lab> qa qa/city-data.dump.json <mq>/cards",
  "python -I source/families.py qa",
  "python -I source/render_ledger.py .",
  "python -I source/draw_map.py <lab> qa/snapshot-ledger.json qa/city-data.dump.json preview/region-status-map.png"
 ],
 "note": "status.json 内容在本清单中以 SHA 绑定；delivery-manifest.json 自身不含自身 SHA。"
