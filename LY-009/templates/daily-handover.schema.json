{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "LY-009/templates/daily-handover.schema.json",
 "title": "东汉洛阳席位每日交接 v1",
 "type": "object",
 "additionalProperties": false,
 "required": ["seat", "date", "status", "baseline", "dependencies", "products", "sources", "openItems", "cityReadiness", "fiveClaims", "next", "writeCheck"],
 "properties": {
  "seat": {"type": "string", "pattern": "^LY-(0\\d[1-9]|0[1-9]0|100)$"},
  "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
  "time": {"type": "string"},
  "status": {"enum": ["待输入", "可开工", "制作中", "待验收", "阻断", "复用完成", "交付完成"]},
  "baseline": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
  "baselineNote": {"type": "string"},
  "dependencies": {"type": "array", "items": {"type": "object", "additionalProperties": false,
   "required": ["seat", "status"],
   "properties": {"seat": {"type": "string", "pattern": "^LY-\\d{3}$"}, "status": {"type": "string"},
    "statusSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}}}},
  "products": {"type": "array", "items": {"type": "object", "additionalProperties": false,
   "required": ["path", "bytes", "sha256", "readBack"],
   "properties": {"path": {"type": "string"}, "bytes": {"type": "integer", "minimum": 0},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "readBack": {"type": "boolean"}, "note": {"type": "string"}}}},
  "sources": {"type": "array", "items": {"type": "object", "additionalProperties": false,
   "required": ["what", "path", "sha256", "bytesKind"],
   "properties": {"what": {"type": "string"}, "path": {"type": "string"},
    "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "bytesKind": {"enum": ["提交字节", "本机检出字节", "本机生成", "从GLB重建", "阻断：缺源包", "外部网页"]},
    "url": {"type": "string"}, "excerpt": {"type": "string", "maxLength": 120}}}},
  "openItems": {"type": "array", "items": {"type": "object", "additionalProperties": false,
   "required": ["item", "to"],
   "properties": {"item": {"type": "string"}, "to": {"type": "string"}, "pause": {"type": ["string", "null"], "pattern": "^PZ-\\d{2}$"}}}},
  "cityReadiness": {"enum": ["可接城", "只能局部包", "不涉及城市"]},
  "cityAdmissionRef": {"type": "string"},
  "fiveClaims": {"type": "object", "additionalProperties": false,
   "required": ["模型能读取", "局部通行通过", "已入城", "真实结构安全", "历史复原成立"],
   "properties": {
    "模型能读取": {"$ref": "#/$defs/claim"}, "局部通行通过": {"$ref": "#/$defs/claim"},
    "已入城": {"$ref": "#/$defs/claim"}, "真实结构安全": {"$ref": "#/$defs/claim"}, "历史复原成立": {"$ref": "#/$defs/claim"}}},
  "next": {"type": "array", "items": {"type": "object", "additionalProperties": false,
   "required": ["direction", "seat", "what"],
   "properties": {"direction": {"enum": ["等待", "交给"]}, "seat": {"type": "string"}, "what": {"type": "string"}}}},
  "writeCheck": {"type": "object", "additionalProperties": false, "required": ["ruleset", "verdict", "paths"],
   "properties": {"ruleset": {"const": "LY-009 whitelist v1"}, "verdict": {"enum": ["PASS", "FAIL"]},
    "paths": {"type": "integer", "minimum": 0}, "failReasons": {"type": "array", "items": {"type": "string"}}}},
  "locksRead": {"type": "array", "items": {"type": "string", "pattern": "^(LOCK|RIGHT)-[A-Z0-9-]+$"}},
  "pausesRaised": {"type": "array", "items": {"type": "string"}},
  "pausesCleared": {"type": "array", "items": {"type": "string"}},
  "evidence": {"type": "array", "items": {"type": "object", "additionalProperties": false,
   "required": ["claim", "class"],
   "properties": {"claim": {"type": "string"}, "class": {"enum": ["原始考古/原文", "异地异期类比", "C工程设计", "未知"]},
    "ref": {"type": "string"}}}}
 },
 "$defs": {
  "claim": {"type": "object", "additionalProperties": false, "required": ["result"],
   "properties": {"result": {"enum": ["做到", "未做", "不适用"]},
    "evidence": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
 }
}
