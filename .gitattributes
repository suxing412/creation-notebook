# Preserve model buffers and source archives byte for byte.
*.bin binary
*.glb binary
*.gltf -text
*.part* binary
*.zip binary
*.7z binary
*.blend binary
*.blend[0-9] binary

# Raster images and texture files.
*.png binary
*.webp binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.ico binary
*.tif binary
*.tiff binary
*.exr binary
*.hdr binary

# Self-hosted font files.
*.woff2 binary
*.woff binary
*.ttf binary
*.otf binary
